# Fixed offline validator for SDK v2 ITMS extension packages.
#
# It validates sandboxed and declarative packages: static rules, layout, the
# contract, JavaScript registration and the package's own tests. It never runs
# candidate code in the backend process; candidate execution happens inside this
# fixed container with no network, no host mounts and a non-root user.
#
# The base is the current public backend image that the operator builds from
# this repository's Dockerfile (`itsm-backend:0.1.0`), identified by its locally
# inspected image ID. There is no implicit or machine-specific base ID and no
# private verification image: the caller must pass VALIDATOR_BASE_ID and the
# build fails closed when it is missing or is not a full `sha256:` image ID.
#
#   docker build -t itsm-backend:0.1.0 .
#   docker image inspect itsm-backend:0.1.0 --format '{{.Id}}'
#
# Build without network or pulls once that base and the Bun image are local:
#
#   docker build --pull=false --network=none \
#     --build-arg VALIDATOR_BASE_ID=sha256:<id from docker image inspect> \
#     --build-arg BUN_IMAGE=oven/bun@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 \
#     -f Dockerfile.extension-validator -t itsm-extension-validator:1 .
#
# The image contains no application checkout, database, credentials or Docker
# socket. Only the SDK validator resources and a fixed Bun binary are copied.
# Candidate code runs with no network and no host mounts.

ARG VALIDATOR_BASE=itsm-backend:0.1.0
ARG BUN_IMAGE=oven/bun@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895

FROM ${BUN_IMAGE} AS js

FROM ${VALIDATOR_BASE}

ARG VALIDATOR_BASE_ID
ARG VALIDATOR_BASE
ARG BUN_IMAGE

# Fail closed before copying anything: the label below is only meaningful for a
# caller-supplied, locally inspected ID, never for a tag or a remembered digest.
RUN set -eu; \
    python3 -c 'import re, sys; sys.exit(0 if re.fullmatch(r"sha256:[0-9a-f]{64}", sys.argv[1]) else 1)' "${VALIDATOR_BASE_ID}" || { \
      echo "VALIDATOR_BASE_ID is required: docker image inspect ${VALIDATOR_BASE} --format '{{.Id}}'" >&2; \
      echo "then pass --build-arg VALIDATOR_BASE_ID=sha256:<id>; a tag is not provenance" >&2; \
      exit 1; \
    }

LABEL org.opencontainers.image.title="ITMS extension validator"
LABEL org.itsm.validator.protocol="2"
LABEL org.itsm.validator.base.id="${VALIDATOR_BASE_ID}"
LABEL org.itsm.validator.js="bun 1.4.2 (oven/bun@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895)"
LABEL org.itsm.validator.network="none"
LABEL org.itsm.validator.user="10001:10001"

# The base carries the backend checkout at /app and persistent data at /data.
# Neither belongs in a validator, and removing them prevents candidate code
# from reading the host core implementation.
USER root
RUN rm -rf /app /data \
    && mkdir -p /validator/itsm/extensions \
    && chown -R 10001:10001 /validator

# Only the SDK resources are copied: schema, contract, package containment and
# the in-container harness. No backend module, migration or test is included.
COPY --chown=10001:10001 itsm/extensions/sdk /validator/itsm/extensions/sdk

# Bun is the honest JavaScript engine available offline. Node is not present.
COPY --from=js --chown=10001:10001 /usr/local/bin/bun /usr/local/bin/bun

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

WORKDIR /work
USER 10001:10001

CMD ["/usr/local/bin/python3", "-I", "-B", "/validator/itsm/extensions/sdk/validator/run.py"]
