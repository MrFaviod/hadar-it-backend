{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itsm.local/sdk/extension.schema.json",
  "title": "ITSM native extension manifest",
  "description": "Version 1 manifest contract for trusted native extensions. The host owns installation; this schema defines the package declaration only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sdkVersion",
    "id",
    "name",
    "description",
    "version",
    "permissions",
    "corePermissions",
    "operations",
    "collections",
    "schemaVersion",
    "compatibleSchemaVersions",
    "migrations",
    "frontend",
    "schedules",
    "skills"
  ],
  "properties": {
    "sdkVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "corePermissions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
        "maxLength": 96
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "collections": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "compatibleSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      }
    },
    "migrations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/migration"
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "pages", "assetPanels"],
      "properties": {
        "entry": {
          "const": "frontend.js"
        },
        "pages": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/contribution"
          }
        },
        "assetPanels": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/contribution"
          }
        }
      }
    },
    "schedules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/schedule"
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label", "description"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^ext_[a-z0-9_]+\\.[a-z][a-z0-9_]{1,63}$",
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "permission", "mutation", "parameters"],
      "properties": {
        "name": {
          "$ref": "#/$defs/handlerName"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "permission": {
          "type": "string",
          "pattern": "^ext_[a-z0-9_]+\\.[a-z][a-z0-9_]{1,63}$",
          "maxLength": 128
        },
        "mutation": {
          "type": "boolean"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "$ref": "#/$defs/handlerName"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "handler"],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "to": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "handler": {
          "$ref": "#/$defs/handlerName"
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "component", "permission"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,47}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]{1,63}$"
        },
        "permission": {
          "type": "string",
          "pattern": "^ext_[a-z0-9_]+\\.[a-z][a-z0-9_]{1,63}$",
          "maxLength": 128
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "handler", "intervalSeconds", "permission"],
      "properties": {
        "name": {
          "$ref": "#/$defs/handlerName"
        },
        "handler": {
          "$ref": "#/$defs/handlerName"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        },
        "permission": {
          "type": "string",
          "pattern": "^ext_[a-z0-9_]+\\.[a-z][a-z0-9_]{1,63}$",
          "maxLength": 128
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "path"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 48
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "path": {
          "type": "string",
          "pattern": "^skills/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/SKILL\\.md$",
          "maxLength": 120
        }
      }
    },
    "handlerName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "required": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["array", "boolean", "integer", "number", "object", "string"]
        }
      }
    }
  }
}
