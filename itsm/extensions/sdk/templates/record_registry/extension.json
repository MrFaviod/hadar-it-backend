{
  "sdkVersion": 2,
  "runtime": "sandboxed",
  "id": "{{EXT_ID}}",
  "name": "{{EXT_NAME}}",
  "description": "{{EXT_DESCRIPTION}}",
  "version": "{{EXT_VERSION}}",
  "storage": {"engine": "sqlite"},
  "capabilities": [],
  "permissions": [
    {
      "code": "{{PERMISSION_PREFIX}}records_read",
      "label": "Consultar registros",
      "description": "Listar y consultar los registros del módulo."
    },
    {
      "code": "{{PERMISSION_PREFIX}}records_write",
      "label": "Gestionar registros",
      "description": "Crear y actualizar los registros del módulo."
    }
  ],
  "corePermissions": [],
  "operations": [
    {
      "name": "list_records",
      "kind": "handler",
      "description": "Lista los registros del módulo con un límite acotado.",
      "permission": "{{PERMISSION_PREFIX}}records_read",
      "mutation": false,
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {"type": "integer"},
          "status": {"type": "string"},
          "asset_id": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "create_record",
      "kind": "handler",
      "description": "Crea un registro nuevo en el módulo.",
      "permission": "{{PERMISSION_PREFIX}}records_write",
      "mutation": true,
      "parameters": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "status": {"type": "string"},
          "notes": {"type": "string"},
          "asset_id": {"type": "string"}
        },
        "required": ["title"],
        "additionalProperties": false
      }
    }
  ],
  "collections": [
    {
      "name": "records",
      "description": "Registros propios del módulo, aislados en su archivo SQLite.",
      "schema": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "maxLength": 200},
          "status": {"type": "string", "enum": ["open", "closed"]},
          "notes": {"type": "string", "maxLength": 2000},
          "assetId": {"type": "string", "maxLength": 64}
        },
        "required": ["title", "status"],
        "additionalProperties": false
      },
      "references": [
        {"field": "assetId", "entity": "asset", "onArchive": "keep", "onDelete": "flag"}
      ]
    }
  ],
  "schemaVersion": 2,
  "compatibleSchemaVersions": [1, 2],
  "migrations": [
    {
      "from": 1,
      "to": 2,
      "handler": "normalize_status"
    }
  ],
  "frontend": {
    "pages": [
      {
        "id": "records",
        "label": "Registros",
        "icon": "list",
        "permission": "{{PERMISSION_PREFIX}}records_read",
        "view": {
          "table": {
            "operation": "list_records",
            "columns": [
              {"field": "title", "label": "Título"},
              {"field": "status", "label": "Estado"}
            ]
          }
        }
      }
    ],
    "assetPanels": [
      {
        "id": "record-summary",
        "label": "Registro",
        "permission": "{{PERMISSION_PREFIX}}records_read",
        "view": {
          "table": {
            "operation": "list_records",
            "columns": [{"field": "title", "label": "Título"}],
            "filterAsset": "asset_id"
          }
        }
      }
    ],
    "contributions": []
  },
  "schedules": [],
  "skills": [
    {
      "name": "{{EXT_ID}}",
      "description": "Consultar y crear registros del módulo.",
      "path": "skills/{{EXT_ID}}/SKILL.md"
    }
  ]
}
