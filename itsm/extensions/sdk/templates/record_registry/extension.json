    "assetPanels": [
      {
        "id": "record-summary",
        "label": "Registro",
        "component": "RecordSummary",
        "permission": "{{PERMISSION_PREFIX}}records_read"
      }
    ],
    "contributions": []
  },
  "schedules": [],
  "skills": [
    {
      "name": "{{EXT_ID}}",
